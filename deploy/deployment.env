# Empty MODEL_DIR uses the adjacent DeepSeek-V4.1-Flash snapshot.
MODEL_DIR=
BIND_HOST=127.0.0.1
API_PORT=8005
START_TIMEOUT_SECONDS=7200
# Optional externally managed NewAPI root URL.
NEWAPI_BASE_URL=
# Fill only with the verified current root if discovery is unavailable.
CONTAINERD_ROOT_DIR=
# Fixed update defaults. These two switches permit isolated performance A/B.
# legacy reproduces the original Ring/Simple restriction; 0 restores old mHC.
PERF_NCCL=auto
PERF_MHC=1
