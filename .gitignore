# Explicit source allowlist for the offline build workspace.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE
!/CHANGELOG.md
!/VERSION
!/release.json
!/deploy/
!/build/
!/docs/
!/reports/
!/licenses/
!/examples/
!/.github/
**/__pycache__/
**/*.pyc
**/*.swp
**/*.swo
**/runtime/
**/images/
**/node_modules/
**/linux-x86_64/
**/*.safetensors
**/*.gguf
**/*.bin
**/*.tar
**/*.tar.gz
**/*.whl
**/*.deb
**/*.rpm
**/*.partial
**/api-key.txt
**/engine-secret.env
**/auth.json
**/.env
